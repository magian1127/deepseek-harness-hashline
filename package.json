{
  "name": "deepseek-harness-hashline",
  "version": "0.3.1",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "description": "Hash-anchored UTF-8 file reading and atomic editing tools for DeepSeek Harness",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magian1127/deepseek-harness-hashline.git"
  },
  "homepage": "https://github.com/magian1127/deepseek-harness-hashline#readme",
  "bugs": {
    "url": "https://github.com/magian1127/deepseek-harness-hashline/issues"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./core": {
      "types": "./lib/core.d.ts",
      "default": "./lib/core.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "bin",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "bin": {
    "dsh-hashline": "bin/dsh-hashline.mjs"
  },
  "scripts": {
    "build": "npm run build:host && npm run build:client && npm run build:cli",
    "build:host": "tsc --project tsconfig.json",
    "build:client": "tsc --project tsconfig.client.json && tsdown --config tsdown.config.ts",
    "build:cli": "tsc -p tsconfig.cli.json",
    "check:syntax": "node --check lib/core.js && node --check lib/index.js && node --check lib/presentation.js && node --check lib/runtime-entry.js && node --check lib/client.js && node --check bin/dsh-hashline.mjs && node --check test/core.test.mjs && node --check test/presentation.test.mjs && node --check test/plugin.test.mjs && node --check test/client.test.mjs",
    "check": "npm run build && npm run check:syntax",
    "test": "npm run build && node --test test/core.test.mjs test/presentation.test.mjs test/plugin.test.mjs test/client.test.mjs",
    "prepare": "npm run build",
    "prepack": "npm run check && npm test"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "hashline",
    "hash-anchored-editing",
    "coding-agent"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dependencies": {
    "diff": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "external": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  }
}
